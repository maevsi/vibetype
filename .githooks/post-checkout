#!/bin/sh
# Git does not copy the gitignored environment file into new worktrees, so their dev server would start without it.
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

if [ ! -e src/.env ] && [ -f "$main_checkout/src/.env" ]; then
  ln -s "$main_checkout/src/.env" src/.env
fi
