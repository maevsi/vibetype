  "prettier": "./.config/prettier.js",
  "private": true,
  "scripts": {
    "build": "pnpm run build:node",
    "build:analyze": "nuxt analyze",
    "build:node": "nuxt build",
    "build:static": "nuxt generate",
    "certificates": ".config/certificates/mkcert.sh",
    "dev": "pnpm run start:development",
    "generate": "pnpm run build:static",
    "gql:codegen": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" graphql-codegen --config .config/codegen/.rc.dev.ts",
    "gql:codegen:production": "graphql-codegen --config .config/codegen/.rc.prod.ts",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:style",
    "lint:fix": "pnpm run lint:js --fix",
    "lint:js": "eslint --cache",
    "lint:style": "stylelint --cache \"**/*.{vue,css}\" --ignore-path .gitignore",
    "lint:ts": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "start": "pnpm run start:node",
    "start:development": "pnpm run certificates && NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" nuxt dev",
    "start:node": "node node/server/node.mjs",
    "start:static": "serve .output/public --ssl-cert ./.config/certificates/ssl-dev.crt --ssl-key ./.config/certificates/ssl-dev.key",
    "supportedBrowsers": "echo \"export default $(browserslist-useragent-regexp --allowHigherVersions);\" > supportedBrowsers.js"
  },
  "type": "module",
  "version": "16.3.0"
}
